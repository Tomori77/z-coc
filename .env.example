# 复制为 .env 后填写实际值（.env 已被 .gitignore 忽略，不会进入仓库与镜像）

# 现有 MySQL 容器名（前提：docker network create zcoc-net 并 docker network connect zcoc-net <该容器>）
# 备选：MySQL 走宿主机端口时填 host.docker.internal，并在 docker-compose.yml 启用 extra_hosts
MYSQL_HOST=你的mysql容器名
MYSQL_PORT=3306
MYSQL_USERNAME=你的数据库用户
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=你的库名

# 应用对外暴露的宿主机端口（容器内部固定 8080）
APP_PORT=8080

# 应用容器加入的 docker 网络名（必须与 MySQL 容器同网络）
# 1Panel 应用商店安装的 MySQL 通常在 1panel-network；自建网络则填网络名并确保 MySQL 容器已加入
DOCKER_NETWORK=zcoc-net
