# 复制为 .env 后填写实际值（.env 已被 .gitignore 忽略，不会进入仓库与镜像）

# 现有 PostgreSQL 容器名（前提：docker network create zcoc-net 并 docker network connect zcoc-net <该容器>）
# 备选：PostgreSQL 走宿主机端口时填 host.docker.internal，并在 docker-compose.yml 启用 extra_hosts
PGSQL_HOST=你的postgresql容器名
PGSQL_PORT=5432
PGSQL_USERNAME=你的数据库用户
PGSQL_PASSWORD=你的数据库密码
PGSQL_DATABASE=你的库名

# 应用对外暴露的宿主机端口（容器内部固定 8080）
APP_PORT=8080

# 应用容器加入的 docker 网络名（必须与 PostgreSQL 容器同网络）
# 1Panel 应用商店安装的 PostgreSQL 通常在 1panel-network；自建网络则填网络名并确保 PostgreSQL 容器已加入
DOCKER_NETWORK=zcoc-net
